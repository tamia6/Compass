{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass & Level"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指南针与水平仪"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指南針與水平儀"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパスと水準器"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나침반 및 수평계"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boussole et niveau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompass & Wasserwaage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brújula y nivel"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to show your coordinates, elevation, and true north."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于显示当前位置、经纬度、海拔和真北方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於顯示目前位置、經緯度、海拔和真北方向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地、緯度・経度、標高、真北の方向を表示するために位置情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치, 위도·경도, 고도 및 진북 방향을 표시하는 데 사용됩니다。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position permet d’afficher vos coordonnées, votre altitude et le nord géographique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wird für Koordinaten, Höhe und geografischen Norden verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación se usa para mostrar las coordenadas, la altitud y el norte geográfico."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion is used for the level indicator in the center of the compass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于显示指南针中心的水平指示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於顯示指南針中央的水平指示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパス中央の水準器を表示するためにモーションデータを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나침반 중앙의 수평계에 동작 데이터를 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mouvements permettent d’afficher le niveau au centre de la boussole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegungsdaten werden für die Wasserwaage in der Kompassmitte verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento se usa para el indicador de nivel en el centro de la brújula."
          }
        }
      }
    }
  },
  "version": "1.0"
}
